# Hedera operator credentials
OPERATOR_ID=0.0.xxxxx
OPERATOR_KEY=your-operator-private-key

# The URL of the frontend (used by CORS). When deploying set this to your Vercel app domain.
# Example: https://your-frontend.vercel.app
FRONTEND_URL=http://localhost:5173

# PORT for WebSocket server (will be used to run the WS server). Render will provide PORT via env in production.
PORT=8080
